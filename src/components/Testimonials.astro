---
import IrynaYetskaloAvatar from '../assets/images/testimonials/1.png';
import AnnaGuglielmoAvatar from '../assets/images/testimonials/2.png';
import KhrystynaRozhniatovskaAvatar from '../assets/images/testimonials/3.png';
import JasmineLehnisAvatar from '../assets/images/testimonials/4.png';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  t: any;
}

interface TestimonialItem {
  name: string;
  description: string;
  quote: string;
}

interface TestimonialCard {
  item: TestimonialItem;
  avatar: ImageMetadata;
}

const { t } = Astro.props;
const avatars: ImageMetadata[] = [IrynaYetskaloAvatar, AnnaGuglielmoAvatar, KhrystynaRozhniatovskaAvatar, JasmineLehnisAvatar];

const allTestimonials: TestimonialCard[] = t.testimonials.items.map((item: TestimonialItem, index: number) => ({ item, avatar: avatars[index] }));
---

<section id="testimonials">
  <div class="flex flex-col gap-10">
    <div class="bg-neutral-black rounded-2xl w-fit h-fit py-2 mx-auto px-3">
      <span class="icon-[mdi--account-group] size-8 bg-white"></span>
    </div>

    <div class="flex flex-col gap-3 text-center">
      <h2 class="m-0! text-4xl sm:text-5xl font-extrabold">{t.testimonials.title}</h2>
      <p class="text-lg text-neutral-500 leading-8 max-w-3xl mx-auto">{t.testimonials.description}</p>
    </div>
  </div>

  <!-- testimonials cards -->
  <div class="cards-container">
    {allTestimonials.map(({ item, avatar }: TestimonialCard) => (
    <div class="card" data-testimonial-card>
      <Picture src={avatar} alt={item.name} width={80} densities={[1, 2]} loading="lazy" pictureAttributes={{ class: 'avatar' }} />

      <p class="name">{item.name}</p>
      <p class="position">{item.description}</p>

      <blockquote class="quote">
          "{item.quote}"
        </blockquote>
      </div>
    ))}
  </div>
</section>

<script>
  // shuffle testimonials cards to show maximum 3 cards at a time
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#testimonials [data-testimonial-card]'));
  const visibleCardsCount = 3;

  if (cards.length > visibleCardsCount) {
    const shuffledCards = [...cards];

    for (let i = shuffledCards.length - 1; i > 0; i--) {
      const randomIndex = Math.floor(Math.random() * (i + 1));

      [shuffledCards[i], shuffledCards[randomIndex]] = [shuffledCards[randomIndex], shuffledCards[i]];
    }

    const selectedCards = new Set(shuffledCards.slice(0, visibleCardsCount));

    cards.forEach((card) => {
      card.hidden = !selectedCards.has(card);
    });
  }
</script>
