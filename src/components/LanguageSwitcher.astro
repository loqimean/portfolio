---
import { getLocalizedPath } from '../i18n/translations';

interface Props {
  currentLang: string;
}

const { currentLang } = Astro.props;
const LOCALES = [
  { code: 'en', label: 'EN', ariaLabel: 'Switch to English' },
  { code: 'uk', label: 'UK', ariaLabel: 'Перемкнути на Українську' },
  { code: 'pl', label: 'PL', ariaLabel: 'Przełącz na Polski' },
  { code: 'es', label: 'ES', ariaLabel: 'Cambiar a Español' },
] as const;

const currentLocale = LOCALES.find(({ code }) => code === currentLang) ?? LOCALES[0];
---

<details class="lang-dropdown" data-lang-dropdown>
  <summary class="lang-dropdown-trigger" aria-label="Change language">
    <i class="icon-[mdi--earth] lang-dropdown-icon" aria-hidden="true"></i>
    <span>{currentLocale.label}</span>
    <i class="icon-[mdi--chevron-down] lang-dropdown-chevron" aria-hidden="true"></i>
  </summary>

  <ul class="lang-dropdown-menu" role="listbox" aria-label="Language options">
    {LOCALES.map(({ code, label, ariaLabel }) => {
      const href = code === currentLang ? null : getLocalizedPath(code);
      return (
        <li>
          {href ? (
            <a href={href} class="lang-dropdown-item" aria-label={ariaLabel}>{label}</a>
          ) : (
            <span class="lang-dropdown-item lang-dropdown-item-active" aria-current="page">{label}</span>
          )}
        </li>
      );
    })}
  </ul>
</details>

<script>
  const languageDropdowns = document.querySelectorAll('[data-lang-dropdown]');

  languageDropdowns.forEach((dropdown) => {
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node)) return;
      if (!dropdown.contains(event.target)) {
        dropdown.removeAttribute('open');
      }
    });

    dropdown.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        dropdown.removeAttribute('open');
      }
    });
  });
</script>
